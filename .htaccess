# formationsahos.fr — URL sans extension .html (serveur Apache)
# Si le serveur a déjà un fichier .htaccess, fusionner ces règles avec l'existant plutôt que de le remplacer.

Options -MultiViews -Indexes
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Ne pas toucher à l'admin (fichiers PHP)
RewriteRule ^admin(/|$) - [L]

# /index.html ou /index → /
RewriteCond %{THE_REQUEST} \s/+index(\.html)?[\s?] [NC]
RewriteRule ^ / [R=301,L]

# /page.html → /page (redirection permanente, conserve les paramètres ?spe=…&utm_…)
RewriteCond %{THE_REQUEST} \s/+([^?\s]+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /page → sert page.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
